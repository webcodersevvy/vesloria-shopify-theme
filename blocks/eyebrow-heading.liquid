<div class="vsl-block-eyebrow-heading" {{ block.shopify_attributes }}>
  {%- if block.settings.eyebrow != blank -%}
    <p class="vsl-mono vsl-text-eyebrow">{{ block.settings.eyebrow | escape }}</p>
  {%- endif -%}
  {%- if block.settings.heading != blank -%}
    <{{ block.settings.heading_tag }} class="vsl-{{ block.settings.heading_size }}">
      {{ block.settings.heading | escape }}
    </{{ block.settings.heading_tag }}>
  {%- endif -%}
  {%- if block.settings.body != blank -%}
    <p class="vsl-body-lg vsl-text-muted">{{ block.settings.body | escape }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Eyebrow & Heading",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Technical eyebrow",
      "default": "THE VESLORIA PERSPECTIVE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FEWER FORMULATIONS. DEEPER EQUILIBRIUM."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "HTML tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Typography scale",
      "options": [
        { "value": "display-xl", "label": "Display XL" },
        { "value": "h1", "label": "Heading 1" },
        { "value": "h2", "label": "Heading 2" },
        { "value": "h3", "label": "Heading 3" }
      ],
      "default": "h2"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Supporting body copy"
    }
  ],
  "presets": [
    {
      "name": "Eyebrow & Heading"
    }
  ]
}
{% endschema %}
