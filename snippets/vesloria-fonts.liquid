{%- comment -%}
  Self-hosted VESLORIA typography (@font-face via Shopify CDN asset_url).
  Avoids RemoteAsset warnings while preserving Boska, Switzer, and Geist Mono.
{%- endcomment -%}
{{ 'boska-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'switzer-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'geist-mono.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

{% style %}
  @font-face {
    font-family: 'Boska';
    src: url('{{ 'boska-400.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Switzer';
    src: url('{{ 'switzer-400.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Switzer';
    src: url('{{ 'switzer-500.woff2' | asset_url }}') format('woff2');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Geist Mono';
    src: url('{{ 'geist-mono.woff2' | asset_url }}') format('woff2');
    font-weight: 400 500;
    font-style: normal;
    font-display: swap;
  }
{% endstyle %}
