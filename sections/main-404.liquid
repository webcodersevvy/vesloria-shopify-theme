<section class="vsl-section color-{{ section.settings.color_scheme }}">
  <div class="vsl-container">
    <div class="vsl-manifesto vsl-manifesto--box color-scheme-2">
      <p class="vsl-mono vsl-text-eyebrow">{{ 'general.404.eyebrow' | t }}</p>
      <h1 class="vsl-h1 vsl-manifesto__heading">{{ 'general.404.heading' | t }}</h1>
      <p class="vsl-body-lg vsl-text-muted vsl-manifesto__body">{{ 'general.404.subtext' | t }}</p>
      {% render 'vesloria-button',
        label: 'EXPLORE ALL FORMULATIONS',
        url: routes.all_products_collection_url,
        style: 'primary'
      %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main 404",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
