<section class="vsl-section color-{{ section.settings.color_scheme }}">
  <div class="vsl-container">
    <div class="vsl-newsletter">
      {%- if section.settings.eyebrow != blank -%}
        <p class="vsl-mono vsl-text-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="vsl-h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="vsl-body-sm vsl-text-muted vsl-newsletter__desc">{{ section.settings.description | escape }}</p>
      {%- endif -%}

      {%- form 'customer', class: 'vsl-newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">

        {%- if form.posted_successfully? -%}
          <div class="vsl-form-status vsl-form-status--success" role="status">
            {{ 'sections.newsletter.success' | t }}
          </div>
        {%- elsif form.errors -%}
          <div class="vsl-form-status vsl-form-status--error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="vsl-field">
          <label for="NewsletterEmail-{{ section.id }}" class="vsl-mono-xs vsl-text-eyebrow">
            {{ 'sections.newsletter.email_label' | t }}
          </label>
          <input
            id="NewsletterEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            class="vsl-input"
            value="{{ form.email }}"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            placeholder="{{ 'sections.newsletter.email_placeholder' | t }}"
            required
          >
        </div>

        <button type="submit" class="vsl-btn vsl-btn--primary vsl-btn--full">
          <span>{{ 'sections.newsletter.submit' | t }}</span>
        </button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VESLORIA Notes Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "VESLORIA NOTES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A CALMER PERSPECTIVE."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Receive small-batch Reserve release notes, seasonal ritual guidance, and selected correspondence from VESLORIA."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "VESLORIA Notes Newsletter"
    }
  ]
}
{% endschema %}
