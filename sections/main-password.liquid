<section class="vsl-section color-scheme-1">
  <div class="vsl-container vsl-container--narrow">
    <div class="vsl-manifesto vsl-manifesto--box color-scheme-2">
      <p class="vsl-mono vsl-text-eyebrow">{{ 'general.password_page.eyebrow' | t }}</p>
      <h1 class="vsl-h1">{{ 'general.password_page.heading' | t }}</h1>

      {%- if shop.password_message != blank -%}
        <p class="vsl-body-lg vsl-text-muted">{{ shop.password_message }}</p>
      {%- endif -%}

      {%- form 'storefront_password', class: 'vsl-newsletter__form' -%}
        {%- if form.errors -%}
          <div class="vsl-form-status vsl-form-status--error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="vsl-field">
          <label for="Password" class="vsl-mono-xs vsl-text-eyebrow">{{ 'general.password_page.login_form_password_label' | t }}</label>
          <input
            type="password"
            name="password"
            id="Password"
            class="vsl-input"
            autocomplete="current-password"
            placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
          >
        </div>

        <button type="submit" class="vsl-btn vsl-btn--primary vsl-btn--full">
          <span>{{ 'general.password_page.login_form_submit' | t }}</span>
        </button>
      {%- endform -%}

      <p class="vsl-caption vsl-text-eyebrow">{{ 'general.password_page.admin_link_html' | t }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Password",
  "settings": []
}
{% endschema %}
