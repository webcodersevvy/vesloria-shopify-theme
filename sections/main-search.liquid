<section class="vsl-section color-{{ section.settings.color_scheme }}">
  <div class="vsl-container">
    <div class="vsl-page-intro">
      <p class="vsl-mono vsl-text-eyebrow">ARCHIVE SEARCH</p>
      <h1 class="vsl-h1">{{ 'general.search.title' | t }}</h1>
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search" class="vsl-filter-bar">
      <div class="vsl-search-reset" style="width: 100%; max-width: 520px;">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          class="vsl-input vsl-input--surface"
          placeholder="{{ 'general.search.placeholder' | t }}"
          aria-label="{{ 'general.search.placeholder' | t }}"
        >
        <input type="hidden" name="type" value="product">
        <button type="submit" class="vsl-btn vsl-btn--primary" style="height: 42px;">
          <span>{{ 'general.search.submit' | t }}</span>
        </button>
      </div>
    </form>

    {%- if search.performed -%}
      <p class="vsl-mono vsl-text-eyebrow" style="margin-bottom: 32px;">
        {{ 'general.search.results_count' | t: count: search.results_count }}
      </p>

      {%- if search.results_count > 0 -%}
        {%- paginate search.results by 12 -%}
          <div class="vsl-grid-2">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item, loading: 'lazy' %}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endpaginate -%}
      {%- else -%}
        <div class="vsl-empty-box">
          <p class="vsl-body-sm vsl-text-muted">{{ 'general.search.no_results' | t }}</p>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Main Search",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
