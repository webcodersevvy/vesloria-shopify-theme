<section class="vsl-section color-{{ section.settings.color_scheme }}">
  <div class="vsl-container">
    <div class="vsl-macro-split{% if section.settings.image_position == 'right' %} vsl-macro-split--reversed{% endif %}">
      <div class="vsl-macro-split__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              widths: '600, 900, 1200, 1600',
              sizes: '(min-width: 901px) 54vw, 94vw',
              loading: 'lazy',
              alt: section.settings.image.alt | default: section.settings.heading | escape
          }}
        {%- else -%}
          {{ 'product-2' | placeholder_svg_tag }}
        {%- endif -%}
      </div>

      <div class="vsl-macro-split__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="vsl-mono vsl-text-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="vsl-h1">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <p class="vsl-body-lg vsl-text-muted">{{ section.settings.body | escape }}</p>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          {% render 'vesloria-button',
            label: section.settings.button_label,
            url: section.settings.button_url,
            style: 'outline'
          %}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial Macro Split",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image placement (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE VESLORIA APPROACH"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FEWER FORMULATIONS. DEEPER EQUILIBRIUM."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "A measured alternative to multi-step excess. Formulated for long-term barrier resilience rather than temporary intensity — uniting biocompatible lipids, soothing humectants, and weightless sensory elegance."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "EXPLORE THE RITUAL GUIDE"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "Editorial Macro Split"
    }
  ]
}
{% endschema %}
