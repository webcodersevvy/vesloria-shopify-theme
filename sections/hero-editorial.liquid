<section class="vsl-hero color-{{ section.settings.color_scheme }}" aria-label="{{ section.settings.headline | escape }}">
  <div class="vsl-hero__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1200, 1600, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.image.alt | default: section.settings.headline | escape
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>

  <div class="vsl-hero__scrim">
    <div class="vsl-container">
      <div class="vsl-hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="vsl-mono vsl-text-mist">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.headline != blank -%}
          <h1 class="vsl-display-xl vsl-hero__headline">{{ section.settings.headline | escape }}</h1>
        {%- endif -%}

        {%- if section.settings.subcopy != blank -%}
          <p class="vsl-hero__subcopy">{{ section.settings.subcopy | escape }}</p>
        {%- endif -%}

        {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
          <div class="vsl-hero__actions">
            {%- if section.settings.primary_label != blank -%}
              {% render 'vesloria-button',
                label: section.settings.primary_label,
                url: section.settings.primary_url,
                style: 'light'
              %}
            {%- endif -%}
            {%- if section.settings.secondary_label != blank -%}
              {% render 'vesloria-button',
                label: section.settings.secondary_label,
                url: section.settings.secondary_url,
                style: 'primary'
              %}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Editorial",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CONTEMPORARY LUXURY SKINCARE"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "EQUILIBRIUM, CONSIDERED."
    },
    {
      "type": "textarea",
      "id": "subcopy",
      "label": "Subcopy",
      "default": "Barrier-first formulations crafted through cellular restraint, tactile precision, and architectural vessel design."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary CTA label",
      "default": "EXPLORE THE CORE RITUAL"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary CTA label",
      "default": "OUR APPROACH"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Secondary CTA link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Hero Editorial"
    }
  ]
}
{% endschema %}
